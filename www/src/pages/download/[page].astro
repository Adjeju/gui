---
import TextPage from '../../components/TextPage.astro'

// Where /download sends a Linux browser (worker.js): /download/linux, or /download/linux-arm64
// when the browser says it runs on ARM. Chrome always says x86_64, so each page links the other.
// Both lead with the same command: public/install.sh picks the processor itself. The files are
// the worker's /download/<name>, the newest release's copy.
export function getStaticPaths() {
  return [
    { params: { page: 'linux' }, props: { arch: 'x86_64', deb: 'amd64', other: 'linux-arm64' } },
    { params: { page: 'linux-arm64' }, props: { arch: 'arm64', deb: 'arm64', other: 'linux' } },
  ]
}

const { arch, deb, other } = Astro.props
const appImage = `Gui-${arch}.AppImage`
const processor = arch === 'arm64' ? 'ARM (arm64)' : 'Intel and AMD (x86_64)'
const otherProcessor = arch === 'arm64' ? 'Intel or AMD' : 'ARM'
---

<TextPage
  title="Gui for Linux"
  description="Install Gui on Linux with one command, or download the AppImage or .deb package."
  path={`/download/${Astro.params.page}`}
>
  <p>To install Gui, run this in a terminal:</p>
  <pre><code>curl -fsSL https://usegui.com/install.sh | sh</code></pre>
  <p>It adds Gui to your app launcher. Gui updates itself.</p>
  <h2>Install it yourself</h2>
  <p>
    For {processor} processors, download the <a href={`/download/${appImage}`}>AppImage</a> and
    run <code>chmod +x {appImage} && ./{appImage}</code>. On Debian or Ubuntu, you can install the{' '}
    <a href={`/download/Gui-${deb}.deb`}>.deb package</a> instead. It does not update itself.
  </p>
  <p>On an {otherProcessor} computer? <a href={`/download/${other}`}>Download Gui for {otherProcessor}</a>.</p>
</TextPage>

<style>
  pre {
    margin-bottom: var(--s-3);
    padding: var(--s-3);
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  pre code {
    font-size: 0.875rem;
    user-select: all;
  }
</style>
